{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "operation": {
      "enum": [
        "deploy",
        "status",
        "logs",
        "health",
        "smoke",
        "restart",
        "reset",
        "backup",
        "restore",
        "cleanup"
      ]
    },
    "environment": {
      "enum": [
        "staging",
        "production"
      ]
    },
    "ref": {
      "type": "string",
      "minLength": 1
    },
    "service": {
      "enum": [
        "",
        "chamados-backend",
        "chamados-frontend",
        "chamados-postgresql"
      ]
    },
    "tail": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "backup_id": {
      "type": "string"
    },
    "confirm": {
      "enum": [
        "",
        "staging",
        "production"
      ]
    }
  },
  "required": [
    "operation",
    "environment",
    "ref",
    "tail"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "reset",
              "smoke"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "environment": {
            "const": "staging"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "restore"
          }
        }
      },
      "then": {
        "required": [
          "backup_id"
        ],
        "properties": {
          "backup_id": {
            "pattern": "^[0-9]{14}\\.[0-9]+$"
          }
        }
      }
    }
  ]
}
